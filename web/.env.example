# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Public (safe to expose in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=o8hcpsct
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only secrets
# TypeSafe (Jev) API key from https://console.typesafe.ai/
TYPESAFE_API_KEY=
# Sanity API token with the editor role (sanity tokens add "..." --role editor)
SANITY_API_WRITE_TOKEN=
# Shared passcode for the demo verifier desk
VERIFIER_PASSCODE=
# Optional: pin the Jev model (defaults to jev-latest)
# JEV_MODEL=jev-1.13.0
