# Never upload secrets or local build output to Vercel.
**/.env*
!**/.env.example
node_modules
**/node_modules
**/.next
studio/dist
studio/.sanity
.opencode
*.log
*.tsbuildinfo

# Private submission kit and local capture artifacts are not part of the app deploy.
/submission
/handoff
/output
/.playwright-cli

# The reset script's backup includes private receipt scans.
/web/.reset-backups
